# Copia este fichero a .env (o define estas mismas variables en Dokploy) y
# rellena valores reales antes de desplegar. Genera secretos con:
#   python -c "import secrets; print(secrets.token_hex(32))"

LEGO_ADMIN_USER=admin
LEGO_ADMIN_PASSWORD=
LEGO_SESSION_SECRET=
# Opcional: si se define, /mcp exige "Authorization: Bearer <token>".
# Sin definir, /mcp queda abierto (como en local).
LEGO_MCP_TOKEN=
# true en producción (HTTPS); false para pruebas en http://localhost.
LEGO_COOKIE_SECURE=true
